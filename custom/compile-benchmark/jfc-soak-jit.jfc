<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="Soak / Leak Diagnosis"
	description="Long-running soak profile for heap and metaspace leak diagnosis. Light on hot-path overhead; heavy on retention/classloader signal."
	provider="Zac">

	<!-- ============================================================
	     CORE LEAK SIGNAL — must be on, low overhead
	     ============================================================ -->

	<!-- THE event for heap retention: samples old objects + path-to-GC-root.
	     path-to-gc-roots is a separate setting from stackTrace - without it
	     the JVM only records the leaf, not the chain that's keeping it alive.
	     Required for `old-objects` with gc-roots retention-path analysis. -->
	<event name="jdk.OldObjectSample">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="cutoff">0 ns</setting>
		<setting name="path-to-gc-roots">true</setting>
	</event>

	<!-- Per-GC heap summary -->
	<event name="jdk.GCHeapSummary">
		<setting name="enabled">true</setting>
	</event>

	<!-- Metaspace usage gauge — periodic, light -->
	<event name="jdk.MetaspaceSummary">
		<setting name="enabled">true</setting>
		<setting name="period">1 s</setting>
	</event>

	<event name="jdk.MetaspaceAllocationFailure">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
	</event>

	<event name="jdk.MetaspaceOOM">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
	</event>

	<!-- Classloader population over time -->
	<event name="jdk.ClassLoaderStatistics">
		<setting name="enabled">true</setting>
		<setting name="period">5 s</setting>
	</event>

	<!-- Class loads — needed to fingerprint rename pressure; NO stack (volume) -->
	<event name="jdk.ClassLoad">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">false</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<!-- Class defines — REQUIRED to see Lucee PhysicalClassLoader.defineClass.
	     ClassLoad fires only on delegation; PhysicalClassLoader.defineClass is a
	     leaf call so phantom-rename ($cf$<uid>) defines are invisible without this.
	     Stacks enabled for LDEV-4745 phantom-rename residual attribution on 7.1. -->
	<event name="jdk.ClassDefine">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<!-- File IO — enabled for LDEV-4745 phantom-rename investigation: looking
	     at whether bytes-path IOUtil.toBytes(classFile) reads or compile()
	     class file writes stall and create the race window. -->
	<event name="jdk.FileRead">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<event name="jdk.FileWrite">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<!-- Socket IO — HTTP/DB calls. Same 10ms threshold as FileRead/Write to keep
	     noise out of steady-state traffic. socket-all groups by destination host. -->
	<event name="jdk.SocketRead">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<event name="jdk.SocketWrite">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<!-- Connect events catch pool churn / DNS pauses that read/write miss. JDK 20+. -->
	<event name="jdk.SocketConnect">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<event name="jdk.ClassUnload">
		<setting name="enabled">true</setting>
	</event>

	<!-- GC activity — keep, threshold gates volume -->
	<event name="jdk.GarbageCollection">
		<setting name="enabled">true</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<event name="jdk.GCPhasePause">
		<setting name="enabled">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<event name="jdk.GCConfiguration">
		<setting name="enabled">true</setting>
		<setting name="period">beginChunk</setting>
	</event>

	<event name="jdk.GCHeapConfiguration">
		<setting name="enabled">true</setting>
		<setting name="period">beginChunk</setting>
	</event>

	<event name="jdk.YoungGenerationConfiguration">
		<setting name="enabled">true</setting>
		<setting name="period">beginChunk</setting>
	</event>

	<!-- ============================================================
	     LUCEE CUSTOM EVENTS — fire once Tier 1 JFR events land
	     (safe to leave enabled; JFR ignores unknown event names)
	     ============================================================ -->

	<event name="lucee.classloader.PCLFlushed">
		<setting name="enabled">true</setting>
	</event>

	<event name="lucee.classloader.FlushDecision">
		<setting name="enabled">true</setting>
		<setting name="threshold">0 ns</setting>
	</event>

	<event name="lucee.classloader.TemplateRename">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">false</setting>
	</event>

	<event name="lucee.classloader.PCLPoolSnapshot">
		<setting name="enabled">true</setting>
		<setting name="period">5 s</setting>
	</event>

	<!-- ============================================================
	     BACKGROUND / OPERATIONAL — light periodic signals
	     ============================================================ -->

	<event name="jdk.CPULoad">
		<setting name="enabled">true</setting>
		<setting name="period">5 s</setting>
	</event>

	<event name="jdk.JVMInformation">
		<setting name="enabled">true</setting>
		<setting name="period">beginChunk</setting>
	</event>

	<!-- Captures the JFC's per-event enabled state + thresholds at recording start.
	     Required for jfrBlaster sentinel detection in classdefine / compile-pressure /
	     file-io (distinguishes event disabled in JFC from captured but zero fired).
	     Also fills the active-settings block in `info`. Light. -->
	<event name="jdk.ActiveSetting">
		<setting name="enabled">true</setting>
		<setting name="period">beginChunk</setting>
	</event>

	<event name="jdk.SystemProcess">
		<setting name="enabled">false</setting>
	</event>

	<event name="jdk.ThreadStart">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">false</setting>
	</event>

	<event name="jdk.ThreadEnd">
		<setting name="enabled">true</setting>
	</event>

	<!-- Sampled execution profile — coarse, just for CPU hotspot context -->
	<event name="jdk.ExecutionSample">
		<setting name="enabled">true</setting>
		<setting name="period">5 ms</setting>
	</event>

	<!-- ============================================================
	     EXPLICITLY OFF — too noisy for a 1h soak.
	     Flip these to true + stackTrace=true for targeted allocation
	     attribution runs (5-cycle smokes are fine — JFR files ~3-5x
	     larger). Used 2026-05-29 to attribute the toBytes(InputStream)
	     regression after the sampler missed it.
	     ============================================================ -->

	<!-- Per-allocation stacks; sibling jdk.ObjectAllocationSample still kept. -->
	<event name="jdk.ObjectAllocationInNewTLAB">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
	</event>

	<event name="jdk.ObjectAllocationOutsideTLAB">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
	</event>

	<!-- Sampled allocation — useful and cheap -->
	<event name="jdk.ObjectAllocationSample">
		<setting name="enabled">true</setting>
		<setting name="throttle">150/s</setting>
	</event>

	<!-- stackTrace=true: needed to identify the throw site of intermittent failures
	     (e.g. LockInterruptedException with no message context). Volume is light
	     under soak load (~8 throws/sec observed), ~tens of MB of stacks over 1h. -->
	<event name="jdk.JavaExceptionThrow">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<event name="jdk.JavaMonitorEnter">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">100 ms</setting>
	</event>

	<!-- Pair with MonitorEnter for lock-contention coverage. Object.wait() noise
	     filtered by the 100ms threshold. -->
	<event name="jdk.JavaMonitorWait">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">100 ms</setting>
	</event>

	<event name="jdk.ThreadPark">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">1 ms</setting>
	</event>

	<!-- JIT compile events — pairs with ClassDefine/ClassUnload for compile-pressure
	     analysis (catches JIT churn caused by phantom-rename class redefinition).
	     Threshold 0 ms so fast T3/T4 compiles show up — compile-benchmark analysis needs
	     every compile, not just the >100ms outliers. -->
	<event name="jdk.Compilation">
		<setting name="enabled">true</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<event name="jdk.CompilerInlining">
		<setting name="enabled">true</setting>
	</event>

	<event name="jdk.CompilerPhase">
		<setting name="enabled">true</setting>
		<setting name="threshold">0 ms</setting>
	</event>

	<event name="jdk.JitRestart">
		<setting name="enabled">true</setting>
	</event>

	<event name="jdk.Deoptimization">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
	</event>

	<event name="jdk.SafepointBegin">
		<setting name="enabled">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<!-- ============================================================
	     VIRTUAL THREAD / JDK 25 / SAFEPOINT-LATENCY ATTRIBUTION
	     Added 2026-06-22 after a Lucee 8 + JDK 25 + VT testlab JFR
	     was structurally blind to pinning. All low-volume / event-
	     triggered so no measurable soak overhead.
	     ============================================================ -->

	<!-- THE first-line virtual-thread perf diagnostic. Fires when a VT pins
	     its carrier (synchronized block, JNI call, etc.) for >= threshold.
	     20ms matches the JDK profile.jfc default; under it pins are usually
	     trivial. WITHOUT this event a VT-heavy workload is structurally
	     blind to the most common VT performance problem. -->
	<event name="jdk.VirtualThreadPinned">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">20 ms</setting>
	</event>

	<!-- Catches scheduler rejection / submission failures. Only fires on
	     failure so volume is effectively zero in healthy runs. -->
	<event name="jdk.VirtualThreadSubmitFailed">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
	</event>

	<!-- Lock-inflation under contention. Pairs with JavaMonitorEnter at
	     100ms threshold: Inflate at 10ms catches the inflation EVENT
	     (which precedes the long wait) and surfaces the inflating site. -->
	<event name="jdk.JavaMonitorInflate">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<!-- Per-thread time to reach safepoint. Pairs with SafepointBegin: that
	     gives "the safepoint took N us"; this gives "which thread was last
	     to arrive". 10ms threshold keeps volume tiny (12 SafepointBegin
	     events in the prior 245s soak). -->
	<event name="jdk.SafepointLatency">
		<setting name="enabled">true</setting>
		<setting name="stackTrace">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<event name="jdk.SafepointStateSynchronization">
		<setting name="enabled">true</setting>
		<setting name="threshold">10 ms</setting>
	</event>

	<!-- ============================================================
	     CONTINUATION FREEZE/THAW - OFF by default, flip ON for VT
	     overhead deep-dives. Volume is per-yield (potentially huge);
	     even the SLOW subset can fire 100/sec under load. Use:
	       1. VirtualThreadPinned (above) to confirm pinning exists.
	       2. Flip these on for a short capture to attribute WHICH
	          freeze paths dominate.
	     ============================================================ -->
	<event name="jdk.ContinuationFreezeSlow">
		<setting name="enabled">false</setting>
	</event>
	<event name="jdk.ContinuationThawSlow">
		<setting name="enabled">false</setting>
	</event>

	<!-- ExecuteVMOperation + G1 family - DISABLED. Enabled briefly 2026-05-30 to
	     identify VM op safepoint reasons but the per-event overhead dropped
	     throughput 12% and flattened the late-cycle bias we were trying to
	     characterise. Flip on only for targeted single-cycle probes. -->
	<event name="jdk.ExecuteVMOperation">
		<setting name="enabled">false</setting>
	</event>
	<event name="jdk.G1HeapSummary">
		<setting name="enabled">true</setting>
	</event>
	<event name="jdk.G1GarbageCollection">
		<setting name="enabled">false</setting>
	</event>
	<event name="jdk.GCPhaseConcurrent">
		<setting name="enabled">false</setting>
	</event>
	<event name="jdk.GCPhaseConcurrentLevel1">
		<setting name="enabled">false</setting>
	</event>

	<event name="jdk.NativeMethodSample">
		<setting name="enabled">true</setting>
		<setting name="period">20 ms</setting>
	</event>

</configuration>
